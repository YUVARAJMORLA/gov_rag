# ==============================================================================
# GovAssist AI Enterprise MERN Platform - Environment Configuration
# ==============================================================================

# --- Application Server Ports & Networking ---
PORT=5000
PYTHON_BRIDGE_PORT=5001
PYTHON_BRIDGE_URL=http://127.0.0.1:5001
# (In Docker Compose, use: PYTHON_BRIDGE_URL=http://python-bridge:5001)

# --- Database & Persistence ---
# For Docker Compose: mongodb://mongo:27017/gov_rag_mern
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/gov_rag_mern
# For Local/Standalone: mongodb://127.0.0.1:27017/gov_rag_mern
MONGO_URI=mongodb://127.0.0.1:27017/gov_rag_mern

# --- Security & JWT Authentication ---
JWT_SECRET=super_secure_gov_rag_jwt_secret_key_2026_production
JWT_EXPIRES_IN=24h

# --- Seed Accounts (Created automatically on initial startup) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminPassword@123
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=admin@govschemes.gov
ADMIN_SSN=0000-0000-0000

DEMO_USER_USERNAME=citizen1
DEMO_USER_PASSWORD=UserPassword@123
DEMO_USER_FULL_NAME=Rajesh Sharma
DEMO_USER_EMAIL=rajesh.sharma@example.com
DEMO_USER_SSN=1234-5678-9012

# --- Databricks Lakehouse & Unity Catalog Connection ---
DATABRICKS_SERVER_HOSTNAME=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=dapi...
WAREHOUSE_ID=xxxxxxxxxxxxxxxx
CATALOG=rag_catalog
SCHEMA=rag_gov_schema
BATCH_ID=cb2a68fa-2e95-457b-b017-86cee436fa48

# --- Databricks Vector AI Search ---
DATABRICKS_VECTOR_SEARCH_ENDPOINT=rag-gov-endpoint
DATABRICKS_INDEX_NAME=rag_catalog.rag_gov_schema.gold_vector_index
EMBEDDING_MODEL=databricks-gte-large-en
Databricks_LLM_MODEL=databricks-meta-llama-3-3-70b-instruct

# --- AWS Bedrock Foundation Models ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN= (Optional if using temporary STS tokens)

BEDROCK_MODEL_1=google.gemma-3-12b-it
BEDROCK_MODEL_2=nvidia.nemotron-super-3-120b
BEDROCK_MODEL_3=mistral.devstral-2-123b
BEDROCK_MODEL_4=amazon.nova-2-5-sonic

# --- RAG Relevance Threshold (Optional) ---
# Default automatically accommodates Hybrid RRF scores without dropping relevant chunks.
# SIMILARITY_THRESHOLD=0.0005
